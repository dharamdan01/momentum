[Unit]
Description=MOMentum - AI-Powered Meeting Intelligence
After=network.target

[Service]
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/momentum
EnvironmentFile=/home/ubuntu/momentum/.env
ExecStart=/home/ubuntu/momentum/venv/bin/gunicorn app.main:app -k uvicorn.workers.UvicornWorker --bind 127.0.0.1:8000 --workers 2 --timeout 120
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
